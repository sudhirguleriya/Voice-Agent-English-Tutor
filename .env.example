# Set ONE of these (keys stay on the server, never sent to the browser)
OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
#   With OpenRouter, defaults become: TRANSCRIBE_MODEL=google/gemini-2.5-flash (via chat audio input),
#   COACH_MODEL=openai/gpt-5-mini, PRONUNCIATION_MODEL=google/gemini-2.5-flash.
#   Comment out the model lines below to use those defaults.

# Speech-to-text model. Asked to transcribe verbatim (keeps your mistakes and fillers).
TRANSCRIBE_MODEL=gpt-4o-transcribe

# Text model that finds grammar / word-choice / vocabulary mistakes (needs structured outputs).
COACH_MODEL=gpt-5-mini

# Audio-input model that listens to the actual recording for pronunciation issues.
# Leave empty to disable the audio pass (pronunciation is then only inferred from the transcript).
PRONUNCIATION_MODEL=gpt-4o-audio-preview

# Language you are practising
TARGET_LANGUAGE=English

# Where history is stored
DB_PATH=data/coach.db
