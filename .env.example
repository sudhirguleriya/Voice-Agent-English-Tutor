# Copy to .env and fill in ONE key. Keys stay on the server and are never sent to the browser.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...          # use OpenAI directly instead (model ids then have no "openai/" prefix)

# ---- Models (all optional: leave these commented out to use the defaults below) ----
# A variable that is present but EMPTY turns that feature off.

# Speech to text. A dedicated transcriber first: chat models like gpt-audio-mini sometimes OBEY what you say
# ("save it as an artifact...") instead of writing it down.
# STT_MODEL=openai/gpt-4o-mini-transcribe
# STT_FALLBACK=openai/gpt-audio-mini

# Mistakes + suggestions for each sentence (structured JSON). Reasoning effort: minimal | low | medium
# ANALYSIS_MODEL=openai/gpt-5-mini
# ANALYSIS_REASONING=minimal
# SUMMARY_MODEL=openai/gpt-5-mini
# PATTERN_MODEL=openai/gpt-5-mini

# Fast hints while you are still mid-sentence (empty = off)
# HINT_MODEL=google/gemini-2.5-flash-lite

# Practice partner: a voice-native chat model. If it fails, the text model writes the reply and TTS speaks it.
# AGENT_MODEL=openai/gpt-audio-mini
# AGENT_VOICE=alloy
# AGENT_TEXT_FALLBACK=google/gemini-2.5-flash-lite

# Speaker buttons. Order: TTS_MODEL, then TTS_FALLBACK, then the browser's own voice.
# TTS_MODEL=openai/gpt-audio-mini
# TTS_VOICE=alloy
# TTS_FALLBACK=fish-audio/s2-pro
# TTS_FALLBACK_VOICE=

# Language you are practising
# TARGET_LANGUAGE=English

# Storage (SQLite) and the local voice-match model
# DATA_DIR=data
# DB_FILE=voice_coach.db
# SPEAKER_MODEL=wespeaker_en_voxceleb_CAM++.onnx
# SPEAKER_THRESHOLD=          # empty = calibrated from your recording
